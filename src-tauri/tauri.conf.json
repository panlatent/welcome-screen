{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WelcomeScreen",
  "version": "0.1.0",
  "identifier": "io.github.panlatent.welcomescreen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "欢迎屏",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "width": 1920,
        "height": 1080,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://127.0.0.1:*; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "panlatent",
    "copyright": "Copyright (c) 2026 panlatent",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../dist-control": "control"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
